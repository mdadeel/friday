{
  "name": "edith-prototype",
  "private": true,
  "version": "0.1.0",
  "description": "EDITH interactive web prototype. All capabilities are SIMULATED. No model, search, MCP, microphone or filesystem access.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/logic.test.ts && npm run test:services",
    "test:services": "esbuild tests/services.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=build-tests/services.test.mjs && node --test build-tests/services.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "marked": "^18.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
